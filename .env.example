# Copy these values into your IDE run configuration or environment.
# The backend reads real OS environment variables via System.getenv(...).

SERPAPI_API_KEY=replaceme
SERPAPI_ENGINE=google_jobs
SERPAPI_BASE_URL=https://serpapi.com/search.json

MONGODB_URI=replaceme
MONGODB_DB_NAME=joblens
MONGODB_COLLECTION_PREFS=user_preferences
MONGODB_COLLECTION_HISTORY=recommendation_history
MONGODB_COLLECTION_LOGS=request_logs

RESEND_API_KEY=replaceme
DIGEST_FROM_EMAIL=JobLens <jobs@example.com>
RESEND_API_URL=https://api.resend.com/emails
DIGEST_TRIGGER_TOKEN=replace-with-a-long-random-value

# Optional OpenAI-compatible LLM reranker. Leave blank to use the deterministic fallback.
# Qwen US: https://dashscope-us.aliyuncs.com/compatible-mode/v1 + qwen-plus
# Qwen Singapore: use your workspace-specific .../compatible-mode/v1 endpoint.
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/ + gemini-3.1-flash-lite
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

MAX_RESULTS_RETURNED=50
NATIONWIDE_US_MAX_STATES=12
NATIONWIDE_US_MIN_STATES=4
